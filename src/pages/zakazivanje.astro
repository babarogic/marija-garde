---
import Base from '../layouts/Base.astro';

const koraci = [
  {
    id: 'uloga',
    tip: 'radio',
    pitanje: 'Ko ste?',
    opcije: ['Roditelj ili staratelj', 'Profesionalac koji radi sa decom', 'I jedno i drugo'],
  },
  {
    id: 'tema',
    tip: 'checkbox',
    pitanje: 'Šta vas trenutno najviše okupira?',
    napomena: 'Možete izabrati više odgovora.',
    opcije: [
      'Preopterećenost i iscrpljenost',
      'Granice i prioriteti',
      'Komunikacija sa decom',
      'Partnerska i porodična usklađenost',
      'Velike životne odluke i promene',
      'Nešto drugo',
    ],
  },
  {
    id: 'jezik',
    tip: 'radio',
    pitanje: 'Na kom jeziku želite sesiju?',
    opcije: ['Srpski', 'Engleski', 'Francuski', 'Španski'],
  },
  {
    id: 'ime',
    tip: 'text',
    pitanje: 'Kako se zovete?',
    placeholder: 'Vaše ime i prezime',
  },
  {
    id: 'email',
    tip: 'email',
    pitanje: 'Na koju e-mail adresu da vam se javim?',
    placeholder: 'ime@primer.com',
  },
  {
    id: 'termin',
    tip: 'radio',
    pitanje: 'Koji termin vam najviše odgovara?',
    opcije: ['Radnim danom ujutru', 'Radnim danom popodne', 'Radnim danom uveče', 'Vikendom'],
  },
];

const ukupno = koraci.length + 1; // + pregled
---

<Base
  title="Zakažite besplatnih 15 minuta — Marija Garde"
  description="Zakažite besplatnih 15 minuta razgovora online uživo sa Marijom Garde."
>
  <div class="flex min-h-svh flex-col">
    <header class="border-b border-espresso/10">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4 md:px-8">
        <a href="/" class="font-sans text-h3 font-medium tracking-wide text-espresso">Marija Garde</a>
        <a href="/" class="link-quiet text-small">Nazad na početnu</a>
      </div>
    </header>

    <div class="mx-auto w-full max-w-3xl px-6 pt-8 md:px-8" data-progress-wrap>
      <div class="flex items-baseline justify-between">
        <p class="text-small text-espresso/80" data-progress-label>Korak 1 od {ukupno}</p>
      </div>
      <div class="mt-3 h-0.5 w-full rounded-full bg-espresso/10">
        <div
          class="h-0.5 rounded-full bg-coral transition-[width] duration-500 motion-reduce:transition-none"
          style={`width: ${(1 / ukupno) * 100}%`}
          data-progress-bar
        >
        </div>
      </div>
    </div>

    <main class="mx-auto flex w-full max-w-3xl grow flex-col px-6 py-10 md:px-8 md:py-14">
      <h1 class="sr-only">Zakazivanje besplatnih 15 minuta razgovora</h1>
      <form novalidate data-booking data-total={ukupno} class="flex grow flex-col">
        {koraci.map((korak, i) => (
          <fieldset data-step={i} hidden={i !== 0} class="flex grow flex-col">
            <legend class="sr-only">{korak.pitanje}</legend>
            <h2 class="font-serif text-h2 text-espresso" tabindex="-1" data-step-heading>
              {korak.pitanje}
            </h2>
            {korak.napomena && <p class="mt-3 text-small text-espresso/80">{korak.napomena}</p>}

            {korak.tip === 'radio' || korak.tip === 'checkbox' ? (
              <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
                {korak.opcije?.map((opcija) => (
                  <label class="flex cursor-pointer items-center gap-4 rounded-xl border border-espresso/30 px-5 py-4 transition-colors duration-200 hover:border-espresso has-checked:border-espresso has-checked:bg-espresso/5">
                    <input
                      type={korak.tip}
                      name={korak.id}
                      value={opcija}
                      class="size-4 shrink-0 accent-espresso"
                    />
                    <span class="text-body text-espresso">{opcija}</span>
                  </label>
                ))}
              </div>
            ) : (
              <div class="mt-8">
                <label for={`polje-${korak.id}`} class="sr-only">{korak.pitanje}</label>
                <input
                  id={`polje-${korak.id}`}
                  type={korak.tip}
                  name={korak.id}
                  placeholder={korak.placeholder}
                  autocomplete={korak.id === 'email' ? 'email' : 'name'}
                  class="w-full max-w-lg border-b border-espresso/30 bg-transparent pb-3 font-sans text-h3 text-espresso placeholder:text-espresso/60 focus:border-espresso focus:outline-none"
                />
              </div>
            )}

            <p
              class="mt-4 hidden border-l-2 border-terracotta pl-3 text-small font-medium text-espresso"
              data-error
              role="alert"
            >
            </p>

            <div class="mt-auto flex items-center gap-6 pt-12">
              {i > 0 && (
                <button type="button" data-back class="btn-secondary">Nazad</button>
              )}
              <button type="submit" class="btn-primary">Dalje</button>
              <p class="hidden text-small text-espresso/80 sm:block">
                ili pritisnite <kbd class="font-sans">Enter</kbd>
              </p>
            </div>
          </fieldset>
        ))}

        <section data-step={koraci.length} hidden class="flex grow flex-col" aria-label="Pregled zahteva">
          <h2 class="font-serif text-h2 text-espresso" tabindex="-1" data-step-heading>
            Proverite i pošaljite zahtev
          </h2>
          <dl class="mt-8 max-w-lg divide-y divide-espresso/10" data-review></dl>
          <div class="mt-auto flex items-center gap-6 pt-12">
            <button type="button" data-back class="btn-secondary">Nazad</button>
            <button type="submit" class="btn-primary" data-submit>Pošaljite zahtev</button>
          </div>
        </section>
      </form>

      <section hidden data-success class="flex grow flex-col items-center justify-center text-center">
        <p class="eyebrow">Zahtev je poslat</p>
        <h2 class="mt-6 max-w-xl font-serif text-h2 text-espresso" tabindex="-1">
          Hvala vam. Javljam vam se uskoro sa predlogom termina.
        </h2>
        <p class="mt-5 max-w-md text-body text-espresso/90">
          Potvrdu ćete dobiti na ostavljenu e-mail adresu. Razgovor traje 15 minuta, online uživo.
        </p>
        <a href="/" class="btn-secondary mt-10">Nazad na početnu</a>
      </section>
    </main>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-booking]')!;
  const steps = Array.from(form.querySelectorAll<HTMLElement>('[data-step]'));
  const total = Number(form.dataset.total);
  const progressBar = document.querySelector<HTMLElement>('[data-progress-bar]')!;
  const progressLabel = document.querySelector<HTMLElement>('[data-progress-label]')!;
  const review = form.querySelector<HTMLElement>('[data-review]')!;
  const success = document.querySelector<HTMLElement>('[data-success]')!;
  const labels: Record<string, string> = {
    uloga: 'Ko ste',
    tema: 'Trenutno vas okupira',
    jezik: 'Jezik sesije',
    ime: 'Ime',
    email: 'E-mail',
    termin: 'Termin',
  };
  let current = 0;

  // Stub — zameniti stvarnim endpointom (npr. fetch('/api/zakazivanje', { method: 'POST', body })).
  async function submitBooking(data: Record<string, string | string[]>) {
    await new Promise((r) => setTimeout(r, 500));
    console.log('Zahtev za zakazivanje:', data);
    return { ok: true };
  }

  function collect(): Record<string, string | string[]> {
    const fd = new FormData(form);
    const data: Record<string, string | string[]> = {};
    for (const key of ['uloga', 'tema', 'jezik', 'ime', 'email', 'termin']) {
      const values = fd.getAll(key).map(String);
      data[key] = key === 'tema' ? values : (values[0] ?? '').trim();
    }
    return data;
  }

  function showError(step: HTMLElement, message: string) {
    const el = step.querySelector<HTMLElement>('[data-error]');
    if (!el) return;
    el.textContent = message;
    el.classList.remove('hidden');
  }

  function clearError(step: HTMLElement) {
    step.querySelector<HTMLElement>('[data-error]')?.classList.add('hidden');
  }

  function validate(index: number): boolean {
    const step = steps[index];
    const data = collect();
    clearError(step);
    const id = ['uloga', 'tema', 'jezik', 'ime', 'email', 'termin'][index];
    if (!id) return true;
    const value = data[id];
    if (Array.isArray(value) ? value.length === 0 : !value) {
      showError(step, id === 'ime' ? 'Upišite svoje ime.' : id === 'email' ? 'Upišite e-mail adresu.' : 'Izaberite odgovor.');
      return false;
    }
    if (id === 'email') {
      const input = step.querySelector<HTMLInputElement>('input[type="email"]')!;
      if (!input.checkValidity()) {
        showError(step, 'Upišite ispravnu e-mail adresu.');
        return false;
      }
    }
    return true;
  }

  function renderReview() {
    const data = collect();
    review.innerHTML = '';
    for (const [key, label] of Object.entries(labels)) {
      const value = data[key];
      const text = Array.isArray(value) ? value.join(', ') : value;
      const row = document.createElement('div');
      row.className = 'py-4';
      const dt = document.createElement('dt');
      dt.className = 'text-small text-espresso/80';
      dt.textContent = label;
      const dd = document.createElement('dd');
      dd.className = 'mt-1 text-body text-espresso';
      dd.textContent = text || '—';
      row.append(dt, dd);
      review.append(row);
    }
  }

  function goTo(index: number) {
    steps[current].hidden = true;
    current = index;
    const step = steps[current];
    step.hidden = false;
    if (current === steps.length - 1) renderReview();
    progressLabel.textContent =
      current === total - 1 ? 'Pregled' : `Korak ${current + 1} od ${total}`;
    progressBar.style.width = `${((current + 1) / total) * 100}%`;
    const heading = step.querySelector<HTMLElement>('[data-step-heading]');
    heading?.focus();
    step.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
    window.scrollTo({ top: 0, behavior: 'auto' });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (current < steps.length - 1) {
      if (validate(current)) goTo(current + 1);
      return;
    }
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    button.disabled = true;
    button.textContent = 'Slanje…';
    const result = await submitBooking(collect());
    if (result.ok) {
      form.hidden = true;
      document.querySelector<HTMLElement>('[data-progress-wrap]')!.hidden = true;
      success.hidden = false;
      success.querySelector<HTMLElement>('h2')?.focus();
    } else {
      button.disabled = false;
      button.textContent = 'Pošaljite zahtev';
    }
  });

  form.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((btn) =>
    btn.addEventListener('click', () => goTo(Math.max(0, current - 1)))
  );
</script>
