---
const links = [
  { href: '#benefiti', label: 'Benefiti' },
  { href: '#oblasti-rada', label: 'Oblasti rada' },
  { href: '#mapa-podrske', label: 'Mapa podrške' },
  { href: '#utisci', label: 'Utisci' },
  { href: '#paketi', label: 'Ponuda' },
];
---

<header class="sticky top-0 z-50 border-b border-espresso/10 bg-cream/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 md:px-8">
    <a href="/" class="font-sans text-h3 font-medium tracking-wide text-espresso">Marija Garde</a>
    <nav aria-label="Glavna navigacija" class="hidden items-center gap-8 md:flex">
      {links.map(({ href, label }) => (
        <a href={href} class="link-quiet text-small">{label}</a>
      ))}
    </nav>
    <a href="/zakazivanje" class="link-quiet text-small font-medium decoration-coral">
      Zakažite besplatnih 15 minuta
    </a>
  </div>
</header>
