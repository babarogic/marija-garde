---
// Privremeni okvir za fotografiju. Vidljiva etiketa opisuje kadar koji kasnije
// ide na ovo mesto — zameniti sa <Image> zadržavajući iste aspect/layout klase.
interface Props {
  label: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---

<div
  class:list={[
    'flex items-center justify-center overflow-hidden rounded-2xl border border-dashed border-espresso/30 bg-espresso/5 p-6 text-center',
    className,
  ]}
  aria-hidden="true"
  data-reveal
>
  <div class="max-w-64">
    <svg
      class="mx-auto size-6 text-espresso/40"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <circle cx="9" cy="10.5" r="1.5" />
      <path d="M21 16.5 17 12.5a1.5 1.5 0 0 0-2.1 0L7.5 19" />
    </svg>
    <p class="mt-3 text-small text-espresso/60">{label}</p>
  </div>
</div>
