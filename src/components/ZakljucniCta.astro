---
import { Image } from 'astro:assets';
import childFlowers from '../assets/child-flowers.webp';
import familyGolden from '../assets/family-golden.jpg';
import heroMeadow from '../assets/hero-meadow.webp';

// Napomena: ova sekcija je ranije nosila jedini terracotta momenat na strani
// (resources/design.md). Novi raspored — rasute fotografije oko centriranog
// poziva — traži svetlu podlogu, pa terracotta trenutno nije u upotrebi.
//
// Fotografije su privremene (postojeći kadrovi u više izreza); zameniti
// finalnim snimcima zadržavajući iste pozicione klase.
const fotografije = [
  // Gornji levi klaster
  { src: familyGolden, class: 'top-[6%] left-[13%] w-36 aspect-[3/4] hidden lg:block', pos: 'object-top' },
  { src: childFlowers, class: 'top-[8%] left-[5%] w-24 lg:top-[15%] lg:left-[19%] lg:w-44 z-10 aspect-[4/3]', pos: 'object-center' },
  { src: heroMeadow, class: 'top-[26%] left-[3%] w-36 aspect-[4/3] hidden lg:block', pos: 'object-left' },
  // Donji levi ugao
  { src: childFlowers, class: 'bottom-[9%] left-[4%] w-24 lg:w-40 aspect-[4/3]', pos: 'object-bottom' },
  // Desna strana
  { src: familyGolden, class: 'top-[12%] right-[4%] w-24 lg:top-[14%] lg:right-[6%] lg:w-32 aspect-[3/4]', pos: 'object-center' },
  { src: heroMeadow, class: 'top-[48%] right-[3%] w-40 aspect-[3/4] hidden lg:block', pos: 'object-right' },
  // Donji desni klaster
  { src: heroMeadow, class: 'bottom-[15%] right-[13%] w-44 aspect-[4/3] hidden lg:block', pos: 'object-center' },
  { src: familyGolden, class: 'bottom-[7%] right-[4%] w-24 lg:w-36 z-10 aspect-[4/3]', pos: 'object-bottom' },
];
---

<section class="relative overflow-hidden bg-peach" data-reveal-group>
  <div class="absolute inset-0" aria-hidden="true">
    {fotografije.map(({ src, class: klasa, pos }) => (
      <div class:list={['absolute overflow-hidden rounded-lg', klasa]} data-reveal>
        <Image
          src={src}
          alt=""
          class:list={['h-full w-full object-cover', pos]}
          widths={[240, 480]}
          sizes="(min-width: 768px) 200px, 120px"
        />
      </div>
    ))}
  </div>
  <div class="relative z-20 mx-auto max-w-3xl px-6 py-44 text-center md:px-8 md:py-56">
    <p class="eyebrow" data-reveal>Vaš sledeći korak</p>
    <h2 class="mt-6 font-serif text-display text-espresso" data-reveal>
      Srećniji odrasli. Srećnija deca.
      <br class="hidden sm:block" />
      Srećnija planeta.
    </h2>
    <div class="mt-12" data-reveal>
      <a href="/zakazivanje" class="btn-primary">Zakažite besplatnih 15 minuta</a>
    </div>
  </div>
</section>
