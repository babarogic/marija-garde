---
// Variant C — full-bleed hero with a cinematic intro. On load the frame opens
// out of a small rounded window to full bleed while the photo settles from a
// wider crop; the type then arrives on top. Once settled, the photo drifts a
// few pixels against the cursor.
//
// The intro animates clip-path and transform only — never opacity — so the
// photo still counts as the LCP paint.
import { Image } from 'astro:assets';
import heroMeadow from '../assets/hero-meadow.webp';
import { slides } from '../data/heroSlides';
---

<section
  data-hero-cinematic
  data-hero-slider
  class="hero-cinematic relative flex min-h-svh flex-col"
  style="--hero-duration: 7s"
  aria-label="Uvodne poruke"
>
  <div class="hero-media" aria-hidden="true">
    <div class="hero-shift">
      <Image
        src={heroMeadow}
        alt=""
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex w-full max-w-4xl grow flex-col items-center justify-center px-6 pt-28 pb-16 text-center md:px-8">
    <!-- FOTO slot: portret Marije — zameniti sa <Image class="h-full w-full object-cover" alt="Marija Garde" /> unutar ovog kruga. -->
    <div
      class="mb-6 flex size-16 items-center justify-center overflow-hidden rounded-full border border-dashed border-cream/60 bg-cream/10 md:size-20"
      data-intro-item
      aria-hidden="true"
      title="FOTO: portret Marije Garde"
    >
      <svg
        class="size-5 text-cream/70"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <circle cx="9" cy="10.5" r="1.5" />
        <path d="M21 16.5 17 12.5a1.5 1.5 0 0 0-2.1 0L7.5 19" />
      </svg>
    </div>
    <p class="eyebrow text-cream" data-intro-item>Kreator milijardu zagrljaja</p>
    <div class="hero-slides mt-8 w-full">
      {slides.map(({ naslov, tekst }, i) => (
        <div
          class:list={['hero-slide flex flex-col items-center', i === 0 && 'is-active']}
          data-slide
          aria-hidden={i !== 0 ? 'true' : 'false'}
        >
          {i === 0 ? (
            <h1 class="font-serif text-display text-cream">
              {naslov.split(' ').map((rec) => (
                <>
                  <span class="hero-word">{rec}</span>{' '}
                </>
              ))}
            </h1>
          ) : (
            <p class="font-serif text-display text-cream">
              {naslov.split(' ').map((rec) => (
                <>
                  <span class="hero-word">{rec}</span>{' '}
                </>
              ))}
            </p>
          )}
          <p class="hero-sub mx-auto mt-6 max-w-xl text-body text-cream">{tekst}</p>
        </div>
      ))}
    </div>
    <div class="mt-10" data-intro-item style="--intro-delay: 260ms">
      <a href="/zakazivanje" class="btn-reversed focus-visible:outline-cream" data-hero-hold>
        Zakažite besplatnih 15 minuta
      </a>
    </div>
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-6xl px-6 pb-10 md:px-8"
    data-intro-item
    style="--intro-delay: 420ms"
  >
    <div class="flex flex-col items-stretch gap-6 sm:flex-row sm:items-end">
      <nav aria-label="Izbor uvodne poruke" class="grid grow grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-8">
        {slides.map(({ potreba }, i) => (
          <button
            type="button"
            data-slide-nav
            data-hero-hold
            aria-current={i === 0 ? 'true' : 'false'}
            class="group cursor-pointer text-left opacity-80 transition-opacity duration-300 hover:opacity-100 focus-visible:outline-cream aria-[current=true]:opacity-100"
          >
            <span class="flex items-baseline gap-3">
              <span class="text-small text-cream" aria-hidden="true">0{i + 1}</span>
              <span class="text-small font-medium text-cream">{potreba}</span>
            </span>
            <span class="mt-3 block h-0.5 w-full rounded-full bg-cream/30" aria-hidden="true">
              <span class="hero-fill block h-0.5 rounded-full bg-cream" data-fill></span>
            </span>
          </button>
        ))}
      </nav>
      <button
        type="button"
        data-pause
        aria-pressed="false"
        aria-label="Pauzirajte automatsku rotaciju poruka"
        class="mb-0.5 flex size-9 shrink-0 cursor-pointer items-center justify-center self-end rounded-full border border-cream/50 text-cream transition-colors duration-300 hover:border-cream focus-visible:outline-cream"
      >
        <svg data-icon-pause width="10" height="12" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
          <rect x="0" y="0" width="3.5" height="12" rx="1" />
          <rect x="6.5" y="0" width="3.5" height="12" rx="1" />
        </svg>
        <svg data-icon-play hidden width="10" height="12" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
          <path d="M0 0 L10 6 L0 12 Z" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  import { initHeroSlider } from '../scripts/hero-slider';
  import { initHeroParallax } from '../scripts/hero-parallax';

  // The headline stagger is driven by the slider's activate(0), so holding the
  // slider back is what keeps the type from arriving on top of the reveal.
  // Deliberately lands before the frame finishes opening — the type rising
  // through the last third reads better than waiting for a clean handoff.
  const INTRO_HOLD = 900;

  document.querySelectorAll<HTMLElement>('[data-hero-cinematic]').forEach((root) => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    initHeroParallax(root);

    if (reduced) {
      root.classList.add('is-intro-done');
      initHeroSlider(root);
      return;
    }

    window.setTimeout(() => {
      root.classList.add('is-intro-done');
      initHeroSlider(root);
    }, INTRO_HOLD);
  });
</script>
