---
// Variant C — full-bleed hero with a cinematic intro. On load the frame opens
// out of a small rounded window to full bleed while the photo settles from a
// wider crop; the type then arrives on top. Once settled, the photo drifts a
// few pixels against the cursor.
//
// The intro animates clip-path and transform only — never opacity — so the
// photo still counts as the LCP paint.
import { Image } from 'astro:assets';
import heroMeadow from '../assets/hero-meadow.webp';
import { slides } from '../data/heroSlides';
---

<section
  data-hero-cinematic
  data-hero-slider
  class="hero-cinematic relative flex min-h-svh flex-col"
  style="--hero-duration: 7s"
  aria-label="Uvodne poruke"
>
  <div class="hero-media" aria-hidden="true">
    <div class="hero-shift">
      <Image
        src={heroMeadow}
        alt=""
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex w-full max-w-4xl grow flex-col items-center justify-center px-6 pt-28 pb-16 text-center md:px-8">
    <!-- Video pozivnica: zadržite pokazivač ili prst — prsten se puni i otvara
         kratko video predstavljanje. Brzi klik/dodir otvara odmah. -->
    <div class="mb-6 flex flex-col items-center" data-intro-item>
      <button
        type="button"
        data-video-trigger
        data-hero-hold
        aria-haspopup="dialog"
        aria-label="Pogledajte kratko video predstavljanje — oko 1 minut"
        class="group relative cursor-pointer touch-manipulation select-none rounded-full p-2 [-webkit-touch-callout:none] focus-visible:outline-cream"
      >
        <svg
          class="pointer-events-none absolute inset-0 size-full -rotate-90"
          viewBox="0 0 100 100"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="50" cy="50" r="47.5" class="stroke-cream/25" stroke-width="2" />
          <circle
            data-video-ring
            cx="50"
            cy="50"
            r="47.5"
            class="stroke-cream"
            stroke-width="2.5"
            stroke-linecap="round"
            pathLength="100"
            stroke-dasharray="100"
            stroke-dashoffset="100"
          />
        </svg>
        <!-- FOTO slot: portret Marije — zameniti sa <Image class="h-full w-full object-cover" alt="" /> unutar kruga. -->
        <span
          class="flex size-16 items-center justify-center overflow-hidden rounded-full border border-dashed border-cream/60 bg-cream/10 transition-transform duration-300 group-hover:scale-105 md:size-20"
          title="FOTO: portret Marije Garde"
        >
          <svg
            class="size-5 text-cream/70"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <circle cx="9" cy="10.5" r="1.5" />
            <path d="M21 16.5 17 12.5a1.5 1.5 0 0 0-2.1 0L7.5 19" />
          </svg>
        </span>
        <span
          class="absolute bottom-1 right-1 flex size-6 items-center justify-center rounded-full bg-cream text-espresso md:size-7"
          aria-hidden="true"
        >
          <svg width="8" height="10" viewBox="0 0 8 10" fill="currentColor">
            <path d="M0 0 8 5 0 10Z" />
          </svg>
        </span>
      </button>
      <p class="mt-3 text-small text-cream/80" aria-hidden="true">Upoznajte Mariju · 1 min</p>
    </div>
    <p class="eyebrow text-cream" data-intro-item>Kreator milijardu zagrljaja</p>
    <div class="hero-slides mt-8 w-full">
      {slides.map(({ naslov, tekst }, i) => (
        <div
          class:list={['hero-slide flex flex-col items-center', i === 0 && 'is-active']}
          data-slide
          aria-hidden={i !== 0 ? 'true' : 'false'}
        >
          {i === 0 ? (
            <h1 class="font-serif text-display text-cream">
              {naslov.split(' ').map((rec) => (
                <>
                  <span class="hero-word">{rec}</span>{' '}
                </>
              ))}
            </h1>
          ) : (
            <p class="font-serif text-display text-cream">
              {naslov.split(' ').map((rec) => (
                <>
                  <span class="hero-word">{rec}</span>{' '}
                </>
              ))}
            </p>
          )}
          <p class="hero-sub mx-auto mt-6 max-w-xl text-body text-cream">{tekst}</p>
        </div>
      ))}
    </div>
    <div class="mt-10" data-intro-item style="--intro-delay: 260ms">
      <a href="/zakazivanje" class="btn-reversed focus-visible:outline-cream" data-hero-hold>
        Zakažite besplatnih 15 minuta
      </a>
    </div>
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-6xl px-6 pb-10 md:px-8"
    data-intro-item
    style="--intro-delay: 420ms"
  >
    <div class="flex flex-col items-stretch gap-6 sm:flex-row sm:items-end">
      <nav aria-label="Izbor uvodne poruke" class="grid grow grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-8">
        {slides.map(({ potreba }, i) => (
          <button
            type="button"
            data-slide-nav
            data-hero-hold
            aria-current={i === 0 ? 'true' : 'false'}
            class="group cursor-pointer text-left opacity-80 transition-opacity duration-300 hover:opacity-100 focus-visible:outline-cream aria-[current=true]:opacity-100"
          >
            <span class="flex items-baseline gap-3">
              <span class="text-small text-cream" aria-hidden="true">0{i + 1}</span>
              <span class="text-small font-medium text-cream">{potreba}</span>
            </span>
            <span class="mt-3 block h-0.5 w-full rounded-full bg-cream/30" aria-hidden="true">
              <span class="hero-fill block h-0.5 rounded-full bg-cream" data-fill></span>
            </span>
          </button>
        ))}
      </nav>
      <button
        type="button"
        data-pause
        aria-pressed="false"
        aria-label="Pauzirajte automatsku rotaciju poruka"
        class="mb-0.5 flex size-9 shrink-0 cursor-pointer items-center justify-center self-end rounded-full border border-cream/50 text-cream transition-colors duration-300 hover:border-cream focus-visible:outline-cream"
      >
        <svg data-icon-pause width="10" height="12" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
          <rect x="0" y="0" width="3.5" height="12" rx="1" />
          <rect x="6.5" y="0" width="3.5" height="12" rx="1" />
        </svg>
        <svg data-icon-play hidden width="10" height="12" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
          <path d="M0 0 L10 6 L0 12 Z" />
        </svg>
      </button>
    </div>
  </div>
</section>

<!-- VIDEO slot: kratko predstavljanje (~1 min) — postaviti fajl na
     public/videos/marija-predstavljanje.mp4; dok fajl ne postoji, modal
     prikazuje etiketu slota. -->
<div data-video-modal hidden class="fixed inset-0 z-[70] flex items-center justify-center p-4 md:p-8">
  <div class="absolute inset-0 bg-espresso/85" data-video-backdrop></div>
  <div
    role="dialog"
    aria-modal="true"
    aria-label="Video predstavljanje Marije Garde"
    class="relative w-full max-w-3xl"
  >
    <video
      data-video-player
      class="aspect-video w-full rounded-2xl bg-espresso"
      controls
      playsinline
      preload="none"
    >
      <source src="/videos/marija-predstavljanje.mp4" type="video/mp4" />
    </video>
    <div
      data-video-fallback
      hidden
      class="absolute inset-0 flex items-center justify-center rounded-2xl border border-dashed border-cream/40 bg-espresso/95 p-6 text-center"
    >
      <p class="max-w-md text-body text-cream/80">
        VIDEO slot: kratko predstavljanje (~1 min) — šta rešavamo, kako radimo i šta nudimo.
        Dodati fajl <code class="text-cream">public/videos/marija-predstavljanje.mp4</code>
      </p>
    </div>
    <button
      type="button"
      data-video-close
      aria-label="Zatvorite video"
      class="absolute -top-13 right-0 flex size-10 cursor-pointer items-center justify-center rounded-full border border-cream/50 text-cream transition-colors duration-300 hover:border-cream focus-visible:outline-cream"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M1 1l12 12M13 1 1 13" />
      </svg>
    </button>
  </div>
</div>

<script>
  // Video pozivnica na avataru: zadržan pokazivač (1.4s) ili pritisnut
  // prst/taster (0.7s) puni prsten i otvara modal; brzi klik otvara odmah.
  // Uz prefers-reduced-motion prsten miruje i otvara samo klik.
  const trigger = document.querySelector<HTMLButtonElement>('[data-video-trigger]');
  const ring = document.querySelector<SVGCircleElement>('[data-video-ring]');
  const modal = document.querySelector<HTMLElement>('[data-video-modal]');

  if (trigger && ring && modal) {
    const player = modal.querySelector<HTMLVideoElement>('[data-video-player]')!;
    const fallback = modal.querySelector<HTMLElement>('[data-video-fallback]')!;
    const closeBtn = modal.querySelector<HTMLButtonElement>('[data-video-close]')!;
    const backdrop = modal.querySelector<HTMLElement>('[data-video-backdrop]')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let fillAnim: Animation | null = null;

    const resetRing = () => {
      fillAnim?.cancel();
      fillAnim = null;
    };

    const open = () => {
      if (!modal.hidden) return;
      resetRing();
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      player.play().catch(() => {});
      closeBtn.focus();
    };

    const close = () => {
      if (modal.hidden) return;
      player.pause();
      player.currentTime = 0;
      modal.hidden = true;
      document.body.style.overflow = '';
      trigger.focus();
    };

    const fill = (duration: number) => {
      if (reducedMotion || !modal.hidden) return;
      resetRing();
      fillAnim = ring.animate(
        [{ strokeDashoffset: 100 }, { strokeDashoffset: 0 }],
        { duration, easing: 'linear', fill: 'forwards' }
      );
      fillAnim.onfinish = open;
    };

    trigger.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') fill(1400);
    });
    trigger.addEventListener('pointerleave', resetRing);
    trigger.addEventListener('pointercancel', resetRing);
    trigger.addEventListener('pointerdown', () => fill(700));
    trigger.addEventListener('click', open);
    trigger.addEventListener('contextmenu', (e) => e.preventDefault());

    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    // Bez video fajla modal prikazuje etiketu slota umesto crnog okvira.
    const showFallback = () => {
      fallback.hidden = false;
    };
    player.addEventListener('error', showFallback);
    player.querySelector('source')?.addEventListener('error', showFallback);
  }
</script>

<script>
  import { initHeroSlider } from '../scripts/hero-slider';
  import { initHeroParallax } from '../scripts/hero-parallax';

  // The headline stagger is driven by the slider's activate(0), so holding the
  // slider back is what keeps the type from arriving on top of the reveal.
  // Deliberately lands before the frame finishes opening — the type rising
  // through the last third reads better than waiting for a clean handoff.
  const INTRO_HOLD = 900;

  document.querySelectorAll<HTMLElement>('[data-hero-cinematic]').forEach((root) => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    initHeroParallax(root);

    if (reduced) {
      root.classList.add('is-intro-done');
      initHeroSlider(root);
      return;
    }

    window.setTimeout(() => {
      root.classList.add('is-intro-done');
      initHeroSlider(root);
    }, INTRO_HOLD);
  });
</script>
